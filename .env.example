# Firebase web app config — Project Settings → General → Your apps → Web app
# → SDK setup and configuration, in the Firebase console. These are public
# client-side values (safe to ship in a bundle), not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Mboa Trust backend API. Relative by default so requests go
# through the Vite dev server's /api proxy (see vite.config.ts) — that way
# the app works from any device that can reach this dev server (phone over
# LAN, tunnel, etc.), not just the machine the backend happens to run on.
VITE_API_BASE_URL=/api/v1
